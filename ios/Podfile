platform :ios, '16.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'),
    __FILE__
  )

  raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first." unless File.exist?(generated_xcode_build_settings_path)

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end

  raise "FLUTTER_ROOT not found."
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root
)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  # ── Patch gRPC source for Xcode 26.2 Clang compatibility ────────────────
  # gRPC 1.62.x uses `Traits::template CallSeqFactory(...)` without
  # explicit template arguments. Xcode 26.2's Clang now treats this as a
  # hard error (-Wmissing-template-arg-list-after-template-kw). Remove the
  # `template` keyword so the call uses implicit template argument deduction.
  Dir.glob(File.join(installer.sandbox.root.to_s, '**', 'basic_seq.h')).each do |path|
    content = File.read(path)
    if content.include?('Traits::template CallSeqFactory')
      system("chmod", "644", path)
      File.write(path, content.gsub('Traits::template CallSeqFactory', 'Traits::CallSeqFactory'))
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
      config.build_settings['OTHER_LDFLAGS'] = '$(inherited)'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
      # Disable explicit module precompilation to avoid non-modular header
      # errors with firebase_auth on Xcode 26.2
      config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
    end

    # Sanitize any per-file compiler flags that accidentally include
    # build-setting names (e.g. "-GCC_WARN_INHIBIT_ALL_WARNINGS") which
    # are treated as invalid clang options on recent toolchains.
    if target.respond_to?(:source_build_phase) && target.source_build_phase
      target.source_build_phase.files.each do |build_file|
        next unless build_file.settings && build_file.settings['COMPILER_FLAGS']

        flags = build_file.settings['COMPILER_FLAGS']
        sanitized = flags.gsub(/-?GCC_WARN_INHIBIT_ALL_WARNINGS/, '').gsub(/\s+/, ' ').strip

        if sanitized != flags
          build_file.settings['COMPILER_FLAGS'] = sanitized
        end
      end
    end
  end
end
